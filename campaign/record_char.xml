<?xml version="1.0" encoding="iso-8859-1"?>

<root>
	<!-- Give the larger header enough room while preserving dynamic resizing. -->
	<windowclass name="charsheet" merge="join">
		<placement>
			<size width="620" height="720" />
		</placement>
		<sizelimits>
			<minimum width="620" height="700" />
			<dynamic />
		</sizelimits>
	</windowclass>

	<!--
		The CoreRPG overview uses relative anchors. Enlarging the portrait also
		moves the name field to the right and increases the overview row height,
		so the 2E tab content continues below the portrait without collisions.
	-->
	<windowclass name="charsheet_overview" merge="join">
		<sheetdata>
			<picture_charsheet_v2 name="portrait">
				<anchored width="120" height="120" />
				<portraitsize>120</portraitsize>
				<widgetsize>32</widgetsize>
			</picture_charsheet_v2>

			<label_titlechar name="header_classleveltitle">
				<anchored to="name" position="belowleft" offset="0,12" width="190" height="20" />
				<static textres="char_label_classlevel" />
			</label_titlechar>
			<stringc_charclasslevel name="header_classlevel">
				<anchored to="header_classleveltitle" position="belowleft" offset="5,0" width="165" height="20" />
				<script>
					function onValueChanged()
						window.header_class_choose.update();
					end
				</script>
			</stringc_charclasslevel>
			<chooser_label name="header_class_choose">
				<control>header_classlevel</control>
				<class>class</class>
				<path>masterindex</path>
				<anchored to="header_classlevel" position="insidetopleft" />
			</chooser_label>
			<button_charclasslevel name="header_button_classlevel">
				<anchored to="header_classlevel" position="righthigh" relation="relative" offset="0,0" />
			</button_charclasslevel>

			<label_titlechar name="header_racetitle">
				<anchored to="header_classleveltitle" position="right" offset="10,0" width="100" height="20" />
				<static textres="char_label_race" />
			</label_titlechar>
			<stringu name="header_race" source="race">
				<anchored to="header_racetitle" position="belowleft" offset="5,0" width="75" height="20" />
			</stringu>
			<chooser_label name="header_race_choose">
				<record>race</record>
				<class>race</class>
				<path>masterindex</path>
				<anchored to="header_race" position="insidetopleft" />
			</chooser_label>
			<linkfield name="header_racelink" source="racelink">
				<anchored to="header_race" position="righthigh" relation="relative" offset="-5,-3" width="20" height="20" />
				<description field="race" />
				<closetoggle />
				<invisible />
				<script>
					function onInit()
						onValueChanged();
					end
					function onValueChanged()
						setVisible(not isEmpty());
					end
				</script>
			</linkfield>

			<label_titlechar name="header_backgroundtitle">
				<anchored to="header_racetitle" height="20">
					<top />
					<left anchor="right" relation="relative" offset="10" />
					<right parent="rightanchor" relation="current" offset="-5" />
				</anchored>
				<static textres="char_label_background" />
			</label_titlechar>
			<stringu name="header_background" source="background">
				<anchored to="header_backgroundtitle" position="belowleft" offset="5,0" height="20">
					<right offset="-25" />
				</anchored>
			</stringu>
			<chooser_label name="header_background_choose">
				<record>background</record>
				<class>background</class>
				<path>masterindex</path>
				<anchored to="header_background" position="insidetopleft" />
			</chooser_label>
			<linkfield name="header_backgroundlink" source="backgroundlink">
				<anchored to="header_background" position="righthigh" relation="relative" offset="-5,-3" width="20" height="20" />
				<description field="background" />
				<closetoggle />
				<invisible />
				<script>
					function onInit()
						onValueChanged();
					end
					function onValueChanged()
						setVisible(not isEmpty());
					end
				</script>
			</linkfield>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_main" merge="join">
		<sheetdata>
			<!-- Keep inherited anonymous labels valid while removing the old visible row. -->
			<label_charframetop name="classracekittitle">
				<anchored to="contentanchor" height="20">
					<top anchor="bottom" offset="-500" />
					<left />
					<right />
				</anchored>
			</label_charframetop>

			<label_charframetop name="statstitle">
				<anchored to="contentanchor" height="20" width="300">
					<top anchor="bottom" offset="0" />
					<left />
				</anchored>
			</label_charframetop>
		</sheetdata>
	</windowclass>
</root>
